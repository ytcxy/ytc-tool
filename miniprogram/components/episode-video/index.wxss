:host{display:flex;flex:1;min-height:0}.video-lesson{display:flex;flex-direction:column;flex:1;min-height:0;position:relative;background:var(--page-bg);color:var(--text)}
.player-wrap{position:relative;flex-shrink:0;width:100%;height:56.25vw;max-height:34vh;background:#111913}.lesson-player{display:block;width:100%;height:100%}.player-intro{position:absolute;top:0;left:0;right:0;bottom:0;display:flex;flex-direction:column;align-items:center;justify-content:center;background:#16271e;color:#eef4ec}.intro-title{font-size:32rpx;line-height:52rpx}.intro-hint{font-size:24rpx;line-height:48rpx;color:#c0ccbf}
.video-controls,.list-tools{display:flex;align-items:center;justify-content:space-between;flex-shrink:0;padding:0 28rpx;min-height:76rpx;gap:12rpx}.video-controls{border-bottom:1rpx solid var(--border)}.video-controls .plain,.list-tools .plain{font-size:24rpx;padding:16rpx 0;min-height:72rpx;white-space:nowrap}.play-time{font-size:22rpx;color:var(--muted);font-variant-numeric:tabular-nums}.play-mode{font-size:22rpx;color:var(--muted)}.list-tools{background:var(--page-bg);min-height:72rpx}.list-count{font-size:24rpx;font-weight:600;margin-right:auto}.tool-selected{font-weight:700;text-decoration:underline}
.dialogue-scroll{height:0;flex:1;min-height:0;background:var(--surface)}.dialogue-row{position:relative;margin:0;padding:14rpx 28rpx 10rpx;border-bottom:1rpx solid var(--separator);border-left:5rpx solid transparent}.dialogue-active{background:var(--soft-bg);border-left-color:var(--accent)}.dialogue-heading{display:flex;align-items:center;justify-content:space-between;min-height:40rpx;padding-right:70rpx}.dialogue-speaker{font-size:22rpx;color:var(--muted);letter-spacing:1rpx}.clip-button{position:absolute;right:14rpx;top:2rpx;width:88rpx;min-height:88rpx;display:flex;align-items:center;justify-content:center;background:transparent;color:var(--accent);padding:0;font-size:26rpx}.dialogue-zh{font-size:30rpx;line-height:1.5;padding:4rpx 64rpx 0 0;overflow-wrap:anywhere}.dialogue-en{font-family:Georgia,serif;font-size:30rpx;line-height:1.5;color:var(--accent);padding:10rpx 0;overflow-wrap:anywhere}.dialogue-foot{display:flex;justify-content:space-between;align-items:center;min-height:60rpx}.reveal-small,.status-small{font-size:22rpx;padding:12rpx 0;background:transparent;font-weight:400;min-height:60rpx}.status-small{color:var(--muted);min-width:130rpx;text-align:right}.status-mastered,.status-learning{color:var(--accent)}.resume-row{padding:0 28rpx;border-bottom:1rpx solid var(--border)}.resume-row button{font-size:23rpx;text-align:left}.lesson-footer{padding:24rpx 28rpx calc(36rpx + env(safe-area-inset-bottom));text-align:center}.lesson-footer button{font-size:24rpx}.back-current{position:absolute;right:24rpx;bottom:calc(20rpx + env(safe-area-inset-bottom));background:var(--primary-bg);color:var(--on-primary);border-radius:40rpx;padding:14rpx 24rpx;font-size:24rpx;box-shadow:0 4rpx 18rpx var(--shadow)}.compact-error{display:flex;flex-wrap:wrap;align-items:center;gap:12rpx;padding:10rpx 24rpx;background:var(--error-bg);color:var(--error-text);font-size:23rpx;flex-shrink:0;max-height:150rpx;overflow:auto}.compact-error button{font-size:23rpx;padding:10rpx}
