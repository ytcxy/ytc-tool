<view class="page"><view class="eyebrow">YOUR PROFILE</view><view class="hero-title">很高兴认识你。</view><view class="muted">头像和昵称都由你选择，也可以保留默认资料。</view>
 <view wx:if="{{loading}}" class="empty">正在加载…</view><view wx:if="{{error}}" class="error">{{error}}</view>
 <form wx:if="{{!loading}}" bindsubmit="save"><view class="card stack"><button class="avatar-button" open-type="chooseAvatar" bindchooseavatar="choose" disabled="{{uploading || saving}}"><image wx:if="{{avatar}}" class="avatar" src="{{avatar}}" mode="aspectFill"/><view wx:else class="avatar avatar-placeholder">句</view></button><view class="footer-note">{{uploading ? '头像上传中…' : '点击选择头像 · 选择后立即保存'}}</view><view class="separator"></view><view class="muted">昵称</view><input name="nickname" type="nickname" value="{{nickname}}" maxlength="32" placeholder="怎么称呼你？" bindinput="input" bindblur="input" class="nickname" disabled="{{saving}}"/></view><button form-type="submit" class="primary" loading="{{saving}}" disabled="{{saving || uploading}}">保存昵称</button></form>
</view>
