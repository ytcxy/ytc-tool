<view class="page theme-{{theme}}">
 <view class="eyebrow">拾句 · DAILY PRACTICE</view>
 <view class="hero-title">把想说的话，<view>慢慢练熟。</view></view>
 <view class="muted">先看中文，试着回想，再展开参考英文。</view>
 <view wx:if="{{recent}}" class="continue card" bindtap="resume"><view class="eyebrow">继续上次学习 →</view><view class="title stack">{{recent.title}}</view><view class="muted">{{recent.collectionTitle}} · 第 {{recent.sequence}} 集</view></view>
 <view wx:if="{{progressError}}" class="error">学习记录：{{progressError}}</view>
 <view class="row"><view class="section-title">我的学习书架</view><text class="muted">{{total}} 个合集</text></view>
 <view wx:if="{{error}}" class="error">{{error}}<button class="plain" bindtap="load">重新加载</button></view>
 <view wx:for="{{items}}" wx:key="id" class="collection card" data-id="{{item.id}}" bindtap="open" hover-class="pressed">
  <view class="row"><view class="book-mark">EN</view><text class="badge">{{item.episodeCount}} 集</text></view>
  <view class="collection-title">{{item.title}}</view><view class="muted">{{item.description}}</view><view class="start">开始复习 <text>↗</text></view>
 </view>
 <view wx:if="{{loading}}" class="empty">正在整理书架…</view><view wx:elif="{{!items.length && !error}}" class="empty">书架还是空的，内容准备好后会出现在这里。</view>
 <button wx:if="{{items.length < total}}" class="secondary" loading="{{loading}}" disabled="{{loading}}" bindtap="more">加载更多合集</button>
 <view class="footer-note">每天练一点，让表达更自然。</view>
</view>
