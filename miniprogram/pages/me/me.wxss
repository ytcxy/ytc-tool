
.profile-card{align-items:center}.profile-name{display:flex;align-items:center;min-height:112rpx}.profile-name .title{overflow-wrap:anywhere}.profile-edit{flex:0 0 auto;width:auto;margin:0;padding:14rpx 12rpx}
.appearance{margin-top:30rpx}.appearance-mark{font-family:Georgia,serif;font-size:42rpx;color:var(--accent)}.theme-options{display:flex;gap:10rpx;margin-top:24rpx;padding:6rpx;background:var(--secondary-bg);border-radius:18rpx}.theme-option{flex:1;min-width:0;padding:12rpx 8rpx;border-radius:14rpx;background:transparent;color:var(--muted);font-size:23rpx;white-space:nowrap}.theme-selected{background:var(--surface);color:var(--accent);box-shadow:0 2rpx 8rpx var(--shadow)}
