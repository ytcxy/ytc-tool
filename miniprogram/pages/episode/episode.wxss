.progress-line{height:8rpx;background:var(--secondary-bg);border-radius:10rpx;margin:30rpx 0 18rpx;overflow:hidden}.progress-line>view{height:100%;background:var(--accent);transition:width .2s}.toolbar{display:flex;justify-content:space-between;margin:24rpx 0}.sentence-head{margin-bottom:20rpx}.reveal{background:transparent;color:var(--accent);font-size:25rpx;font-weight:500;text-align:left;padding:25rpx 0;margin:8rpx 0 15rpx}.sync{position:sticky;top:0;z-index:5;box-shadow:0 5rpx 15rpx var(--shadow)}

.collapse-hint{font-family:-apple-system,"PingFang SC",sans-serif;font-size:23rpx;text-align:right;margin-top:16rpx;color:var(--muted)}

/* Keep the visible icon small and the touch target comfortable. */
.sentence{position:relative}
.sentence-head.has-audio{padding-right:64rpx}
.speaker-button{position:absolute;top:12rpx;right:12rpx;z-index:1;box-shadow:none;border:0;display:flex;align-items:center;justify-content:center;width:72rpx;height:72rpx;padding:0;margin:0;border-radius:50%;background:transparent;flex-shrink:0}
.speaker-icon{display:block;width:36rpx;height:36rpx}
.speaker-playing .speaker-icon{animation:speaker-breathe 1.2s ease-in-out infinite}
.speaker-spinner{width:30rpx;height:30rpx;border:3rpx solid var(--context-border);border-top-color:var(--accent);border-radius:50%;animation:speaker-spin .8s linear infinite}
.speaker-error-dot{position:absolute;right:9rpx;top:7rpx;width:22rpx;height:22rpx;border-radius:50%;background:var(--danger);color:var(--surface);font-size:16rpx;line-height:22rpx;text-align:center}
.speaker-error-note{font-size:23rpx;color:var(--danger);text-align:right;margin:0 0 12rpx}
@keyframes speaker-spin{to{transform:rotate(360deg)}}
@keyframes speaker-breathe{0%,100%{opacity:1}50%{opacity:.45}}

.actions .learning-selected{background:var(--soft-bg);color:var(--accent);box-shadow:inset 0 0 0 2rpx var(--accent)}

.video-page{position:fixed;top:0;right:0;bottom:0;left:0;display:flex;flex-direction:column;overflow:hidden;background:var(--page-bg)}.video-page app-nav{flex-shrink:0}.video-page episode-video{display:flex;flex:1;min-height:0}
