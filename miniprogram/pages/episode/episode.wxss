.progress-line{height:8rpx;background:#e2e8db;border-radius:10rpx;margin:30rpx 0 18rpx;overflow:hidden}.progress-line>view{height:100%;background:#4f7c4f;transition:width .2s}.toolbar{display:flex;justify-content:space-between;margin:24rpx 0}.sentence-head{margin-bottom:20rpx}.reveal{background:transparent;color:#52734f;font-size:25rpx;font-weight:500;text-align:left;padding:25rpx 0;margin:8rpx 0 15rpx}.sync{position:sticky;top:0;z-index:5;box-shadow:0 5rpx 15rpx #ddd}
