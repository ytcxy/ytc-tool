<page-meta page-style="background-color: {{theme === 'dark' ? '#101612' : '#f5f4ee'}}; color-scheme: {{theme}};" root-background-color="{{theme === 'dark' ? '#101612' : '#f5f4ee'}}" background-color="{{theme === 'dark' ? '#101612' : '#f5f4ee'}}" background-color-top="{{theme === 'dark' ? '#101612' : '#f5f4ee'}}" background-color-bottom="{{theme === 'dark' ? '#101612' : '#f5f4ee'}}" />
<view wx:if="{{episode.video && !loading && !error}}" class="video-page theme-{{theme}}">
 <app-nav title="第{{episode.sequence}}集 · {{episode.title}}" back theme="{{theme}}" />
 <episode-video id="episode-video" episode="{{episode}}" sentences="{{sentences}}" only-unmastered="{{onlyUnmastered}}" all-revealed="{{allRevealed}}" logged-in="{{loggedIn}}" completed="{{completed}}" saving="{{saving}}" saving-sentence-id="{{savingSentenceId}}" save-error="{{saveError}}" progress-error="{{progressError}}" last-sentence-id="{{lastSentenceId}}" mastered="{{mastered}}" bindvideostart="stopAudio" bindposition="videoPosition" bindreveal="videoReveal" bindrevealall="toggleAll" bindfilter="filter" bindshowall="videoShowAll" bindmark="videoMark" bindresume="resume" bindlogin="login" bindcomplete="complete" bindretrysave="retry" bindreload="load" />
</view>
<block wx:else>
<app-nav title="单集复习" back theme="{{theme}}" />
<view class="page theme-{{theme}}">
 <view wx:if="{{error}}" class="error">{{error}}<button class="plain" bindtap="load">重新加载</button></view>
 <view wx:if="{{loading}}" class="empty">正在准备复习内容…</view>
 <block wx:if="{{episode && !loading}}">
  <view class="eyebrow">第 {{episode.sequence}} 集 · RECALL</view><view class="hero-title">{{episode.title}}</view><view class="muted">{{episode.collectionTitle}}</view>
  <view class="progress-line"><view style="width:{{sentences.length ? mastered / sentences.length * 100 : 0}}%"></view></view>
  <view class="row"><text class="muted">{{loggedIn ? '已掌握 ' + mastered + ' / ' + sentences.length + ' 条' : sentences.length + ' 条表达 · 登录后保存进度'}}</text><text class="badge">{{completed ? '本集已完成' : '慢慢练，不着急'}}</text></view>
  <button wx:if="{{!loggedIn}}" class="plain stack" bindtap="login">登录，保存我的学习记录 →</button>
  <view wx:if="{{progressError}}" class="error">进度加载失败：{{progressError}}<button class="plain" bindtap="load">重新加载进度</button></view>
  <button wx:if="{{lastSentenceId}}" class="secondary stack" bindtap="resume">回到上次学习位置</button>
  <view class="toolbar"><button class="plain" bindtap="toggleAll">{{allRevealed ? '全部隐藏' : '全部显示'}}</button><button class="plain" bindtap="filter">{{onlyUnmastered ? '显示全部内容' : '只看未掌握'}}</button></view>
  <view wx:if="{{saveError}}" class="error sync">{{saveError}}<button class="plain" bindtap="retry" disabled="{{saving}}">重试同步</button></view>
  <view wx:for="{{sentences}}" wx:key="id" id="s-{{item.id}}" data-id="{{item.id}}" class="card sentence" hidden="{{onlyUnmastered && item.status === 'mastered'}}">
   <view class="row sentence-head {{item.audioUrl ? 'has-audio' : ''}}"><text class="number">{{item.speakerName || (item.speaker === 1 ? 'AI' : '你')}} · {{item.sequence < 10 ? '0' + item.sequence : item.sequence}}</text></view>
    <view role="button" wx:if="{{item.audioUrl}}" class="speaker-button {{audioSentenceId === item.id ? 'speaker-' + audioState : ''}}" hover-class="none" data-id="{{item.id}}" bindtap="playAudio" aria-label="{{audioSentenceId === item.id ? (audioState === 'loading' ? '取消加载英文音频' : audioState === 'playing' ? '停止朗读英文' : '播放失败，点击重试') : '朗读英文'}}">
     <view wx:if="{{audioSentenceId === item.id && audioState === 'loading'}}" class="speaker-spinner"></view>
     <image wx:else class="speaker-icon" src="{{theme === 'dark' ? '/assets/icons/speaker-dark.svg' : '/assets/icons/speaker.svg'}}" mode="aspectFit" aria-hidden="true" />
     <view wx:if="{{audioSentenceId === item.id && audioState === 'error'}}" class="speaker-error-dot">!</view>
    </view>
   <view wx:if="{{audioSentenceId === item.id && audioState === 'error'}}" class="speaker-error-note">{{audioError}}</view>
   <view wx:if="{{item.context}}" class="context">{{item.context}}</view><view class="chinese">{{item.zh}}</view>
   <view wx:if="{{item.revealed}}" class="english" data-id="{{item.id}}" bindtap="toggle" role="button" aria-label="点击收起参考英文">{{item.en}}<view class="collapse-hint">点击英文区域收起 ↑</view></view>
   <button wx:if="{{!item.revealed}}" class="reveal" data-id="{{item.id}}" bindtap="toggle">想好了吗？查看参考英文 ↓</button>
   <view class="actions"><button class="secondary {{item.status === 'learning' ? 'learning-selected' : ''}}" aria-label="{{item.status === 'learning' ? '还不熟，已选中' : '标记为还不熟'}}" hover-class="none" data-id="{{item.id}}" data-status="learning" bindtap="mark" disabled="{{!!saveError || !!progressError}}">还不熟</button><button class="primary" hover-class="none" data-id="{{item.id}}" data-status="toggle-mastered" bindtap="mark" disabled="{{!!saveError || !!progressError}}">{{item.status === 'mastered' ? '撤销掌握' : '标记掌握'}}</button><button class="plain" hover-class="none" data-id="{{item.id}}" data-status="unseen" bindtap="mark" disabled="{{item.status === 'unseen' || !!saveError || !!progressError}}">重置</button></view>
  </view>
  <view wx:if="{{!visibleCount}}" class="empty">{{onlyUnmastered ? '这一集的表达都已掌握，做得不错。' : '本集内容还在准备中。'}}</view>
  <button wx:if="{{sentences.length}}" class="primary stack" loading="{{saving && !savingSentenceId}}" disabled="{{saving || !!saveError || !!progressError}}" bindtap="complete">{{completed ? '撤销本集完成标记' : '标记本集已完成'}}</button>
  <view class="footer-note">英文是一种参考表达，能表达原意同样很好。</view>
 </block>
</view>

</block>
