<view class="page"><view class="eyebrow">ONE MORE TIME</view><view class="hero-title">再练一遍。</view><view class="muted">{{total}} 条还不熟的表达，按单集顺序回顾。</view><view wx:if="{{error}}" class="error">{{error}}<button class="plain" bindtap="load">重新加载</button></view>
 <view wx:for="{{items}}" wx:key="id" class="card stack"><view class="muted">{{item.collectionTitle}} · 第 {{item.episodeSequence}} 集</view><view class="title">{{item.episodeTitle}}</view><view class="separator"></view><view wx:if="{{item.context}}" class="context">{{item.context}}</view><view class="chinese">{{item.zh}}</view><view wx:if="{{item.revealed}}" class="english">{{item.en}}</view><button class="plain stack" data-id="{{item.id}}" bindtap="toggle">{{item.revealed ? '隐藏参考英文' : '查看参考英文'}}</button><button class="secondary" data-id="{{item.episodeId}}" bindtap="open">回到单集，查看上下文与更新状态</button></view>
 <view wx:if="{{loading}}" class="empty">正在加载…</view><view wx:elif="{{!items.length && !error}}" class="empty">暂时没有“还不熟”的内容。<view>在单集里标记后，就能在这里复习。</view></view><button wx:if="{{items.length < total}}" class="secondary" bindtap="more" loading="{{loading}}" disabled="{{loading}}">加载更多</button>
</view>
