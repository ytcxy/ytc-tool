:host{display:block}.tab-bar{position:fixed;z-index:1000;left:0;right:0;bottom:0;height:100rpx;padding-bottom:env(safe-area-inset-bottom);display:flex;background:#fff;border-top:1rpx solid #e6e9df;color:#777d73}.tab-bar-dark{background:#18211b;border-top-color:#303c33;color:#9aa69c}.tab-item{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2rpx}.tab-mark{font-family:Georgia,serif;font-size:27rpx;line-height:1.2}.tab-text{font-size:21rpx;line-height:1.2}.selected{color:#245b43}.tab-bar-dark .selected{color:#91c3a1}
